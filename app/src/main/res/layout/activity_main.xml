<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HindiTap"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- ============ Step 1 ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="1. Language model"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.65"
            android:lineSpacingMultiplier="1.3"
            android:text="Ek hi baar, ~30 MB. Iske baad translation offline chalegi." />

        <Button
            android:id="@+id/downloadButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Download Hindi model" />

        <TextView
            android:id="@+id/downloadStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.3"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Gemini API key (optional)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.65"
            android:lineSpacingMultiplier="1.3"
            android:text="aistudio.google.com/apikey se free key banayein (card nahi chahiye). Key daalne par sabse achhi Hindi milegi — Gemini ko pata hota hai ki newspaper headline hai, aur OCR ki chhoti galtiyan bhi khud sudhaar leta hai.\n\nKey sirf is phone mein save hoti hai. Khali chhod denge toh app public endpoint use karegi." />

        <EditText
            android:id="@+id/geminiKeyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="AIza…"
            android:inputType="textPassword"
            android:maxLines="1" />

        <Button
            android:id="@+id/saveKeyButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save key and test" />

        <TextView
            android:id="@+id/keyStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingMultiplier="1.3"
            android:visibility="gone" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/offlineSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Hamesha offline model use karein" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:alpha="0.65"
            android:lineSpacingMultiplier="1.3"
            android:text="OFF (recommended): internet hone par Google ka bada model — behtar Hindi. Internet na ho toh khud offline par chala jaata hai.\n\nON: text kabhi phone se bahar nahi jaata, lekin translation quality kam hogi." />

        <!-- ============ Step 2: e-paper / OCR ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="2. E-paper mode (image PDFs)"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.65"
            android:lineSpacingMultiplier="1.3"
            android:text="TOI / HT e-paper image hoti hai — text select hi nahi hota. Yeh mode screen padhta hai.\n\nChalu karne par ek floating bubble aayega. E-paper kholein → bubble tap karein → paragraph ke upar box banayein → Hindi translation neeche aa jayegi. E-paper band nahi hogi.\n\nDo permission maangi jayengi: &quot;Display over other apps&quot; aur screen capture." />

        <TextView
            android:id="@+id/bubbleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Screen reader: OFF"
            android:textStyle="bold" />

        <Button
            android:id="@+id/bubbleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Start screen reader" />

        <Button
            android:id="@+id/stopButton"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Stop" />

        <!-- ============ Step 3: text apps ============ -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="3. Normal text wale apps"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.65"
            android:lineSpacingMultiplier="1.3"
            android:text="Browser, notes, chat, email: text select karein → popup mein &quot;हिंदी&quot; (ya ⋮ ke andar). Kuch setup nahi chahiye.\n\nJin PDF readers ka apna selection menu hota hai (Adobe, Drive): select → Copy → shade kholein → &quot;हिंदी&quot; tile." />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:alpha="0.2"
            android:background="?android:attr/textColorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Clipboard / manual paste"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/clipLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.6"
            android:text="Clipboard se liya gaya."
            android:textSize="12sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/inputText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="top"
            android:hint="Yahan text paste karein"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <Button
            android:id="@+id/translateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Translate" />

        <TextView
            android:id="@+id/pasteResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.3"
            android:textIsSelectable="true"
            android:textSize="17sp" />
    </LinearLayout>
</ScrollView>
