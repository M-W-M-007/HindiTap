<?xml version="1.0" encoding="utf-8"?>
<!--
  Height is capped by the service, and the scrolling area takes whatever is left
  after the buttons. That ordering matters: when the text area was allowed to
  grow freely, a long paragraph pushed the buttons off the bottom of the screen
  and the overlay covered everything with no way to dismiss it.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/panel_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <ScrollView
        android:id="@+id/panelScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/panelResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.35"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/panelSource"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="8dp"
        android:background="#33FFFFFF" />

    <!-- Always visible, never scrolled away. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/panelSpeakEn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="🔊 English"
            android:textColor="#4CD7A0"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panelSpeakHi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="🔊 हिंदी"
            android:textColor="#4CD7A0"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panelCopy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Copy"
            android:textColor="#4CD7A0"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panelClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Close"
            android:textColor="#FF8A80"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
